# Copie para /etc/suricatoos-monitor.env no Kali e ajuste (chmod 600).
# NÃO comitar o arquivo real — só este exemplo.
#
# Os CANAIS (Teams on/off + webhook, e-mail on/off + destinatário) são
# configurados no painel /admin (aba Alertas) e vivem no Convex. Aqui ficam só
# os SEGREDOS de servidor:

# Ler a config de canais no Convex (mesmo valor de CONVEX_SERVICE_ROLE_KEY do Next)
CONVEX_SERVICE_KEY=

# Enviar e-mail via Resend (canal e-mail). Domínio suricatoos.com já verificado.
RESEND_API_KEY=
#ALERT_EMAIL_FROM=Suricatoos Alertas <alertas@suricatoos.com>

# ---- Ajustes opcionais (têm defaults sensatos no script) ----
#SITE_URL=https://ai.suricatoos.com
#CONVEX_URL=https://dutiful-sheep-343.convex.cloud
#SERVICES=suricatoos-next suricatoos-trigger suricatoos-connector caddy centrifugo
#MIN_AVAIL_MB=150
#MAX_DISK_PCT=90
#HEARTBEAT_HOUR=9          # hora local do heartbeat diário "tudo ok"; vazio desliga
#HOSTLABEL=kali-suricatoos
