# Copie para /etc/suricatoos-monitor.env no Kali e ajuste (chmod 600).
# NÃO comitar o arquivo real — só este exemplo.

# ---- Canal de alerta: escolha UM ----

# Opção A) Telegram (recomendado — push instantâneo, sem domínio/deliverability)
#   1. No Telegram, fale com @BotFather -> /newbot -> copie o token
#   2. Mande qualquer msg pro seu bot, depois pegue seu chat_id em:
#      https://api.telegram.org/bot<TOKEN>/getUpdates  (campo chat.id)
#TELEGRAM_BOT_TOKEN=123456:ABC-...
#TELEGRAM_CHAT_ID=123456789

# Opção B) E-mail via Resend (precisa domínio verificado no Resend)
#RESEND_API_KEY=re_...
#ALERT_EMAIL_FROM=alertas@suricatoos.com
#ALERT_EMAIL_TO=williamsouzadelima@gmail.com

# ---- Ajustes opcionais (têm defaults sensatos no script) ----
#SITE_URL=https://ai.suricatoos.com
#CONVEX_URL=https://dutiful-sheep-343.convex.cloud
#SERVICES=suricatoos-next suricatoos-trigger suricatoos-connector caddy centrifugo
#MIN_AVAIL_MB=150
#MAX_DISK_PCT=90
#HEARTBEAT_HOUR=9          # hora local do heartbeat diário "tudo ok"; vazio desliga
#HOSTLABEL=kali-suricatoos
